# Plantilla, NO credenciales reales. No arrancar sin autorización/proveedor/TLS/red verificados.
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=false
SECRET_KEY=REEMPLAZAR_EN_GESTOR_DE_SECRETOS_POR_VALOR_NUEVO_DE_50_O_MAS_CARACTERES
ALLOWED_HOSTS=logistech.example.invalid
CSRF_TRUSTED_ORIGINS=https://logistech.example.invalid
# true SOLO tras verificar proxy privado que sustituye X-Forwarded-Proto.
TRUSTED_TLS_PROXY=false
POSTGRES_DB=logistech
POSTGRES_USER=REEMPLAZAR_POR_ROL_DE_APLICACION
POSTGRES_PASSWORD=REEMPLAZAR_EN_GESTOR_DE_SECRETOS
DB_HOST=REEMPLAZAR_POR_HOST_PRIVADO_CON_CERTIFICADO_VALIDO
DB_PORT=5432
DB_CONNECT_TIMEOUT=3
# producción fuerza sslmode=verify-full; montar CA público del proveedor de confianza.
DB_SSLROOTCERT=/run/config/postgresql-ca.pem
VITE_API_BASE_URL=/api/v1
