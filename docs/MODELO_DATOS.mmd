%% Esquema de negocio actualizado en F6: 0001 conservadas y User.branch agregado en 0002.
%% Se omiten tablas de framework (Django auth, sesiones, Admin y blacklist); ver BASE_DE_DATOS.md.
%% UNIQUE por empresa y CHECK se detallan en modelos/migraciones/documentación.
erDiagram
    COMPANY o|--o{ USER : asignacion_opcional
    BRANCH o|--o{ USER : asignacion_organizativa_opcional
    COMPANY ||--o{ BRANCH : posee
    COMPANY ||--o{ CATEGORY : clasifica
    COMPANY ||--o{ PRODUCT : posee
    COMPANY ||--o{ BOX : aisla
    CATEGORY ||--o{ PRODUCT : categoriza
    PRODUCT ||--o{ BOX : producto_unico
    BRANCH ||--o{ BOX : almacena
    USER ||--o{ BOX : crea
    COMPANY ||--o{ RECEIPT : registra
    COMPANY ||--o{ BOX_EVENT : aisla_historia
    BOX ||--o| RECEIPT : resolucion_unica
    BRANCH ||--o{ RECEIPT : recibe
    BRANCH ||--o{ BOX_EVENT : referencia
    USER ||--o{ RECEIPT : realiza
    USER ||--o{ BOX_EVENT : actua
    COMPANY {
        uuid id PK
        string name
        string status
        datetime created_at
    }
    USER {
        uuid id PK
        string email UK "Tambien UNIQUE Lower email"
        string password "Hash Django"
        string first_name
        string last_name
        string role
        uuid company_id FK "Nullable"
        uuid branch_id FK "Nullable, misma empresa"
        boolean is_active
        boolean is_staff
        boolean is_superuser
        datetime last_login "Nullable"
        datetime created_at
    }
    BRANCH {
        uuid id PK
        uuid company_id FK
        string name "Unico por empresa case insensitive"
        string address
        string status
        datetime created_at
    }
    CATEGORY {
        uuid id PK
        uuid company_id FK
        string name "Unico por empresa case insensitive"
        string description
        boolean is_fragile
        boolean is_perishable
        datetime created_at
    }
    PRODUCT {
        uuid id PK
        uuid company_id FK
        uuid category_id FK
        string sku "Unico por empresa"
        string name
        string description
        string status
        datetime created_at
    }
    BOX {
        uuid id PK
        string internal_id UK "CJ mas UUID independiente"
        uuid qr_code UK
        uuid product_id FK
        uuid company_id FK
        uuid branch_id FK
        int quantity "CHECK mayor que cero"
        decimal weight_kg "Nullable CHECK positivo"
        string priority
        string status
        uuid created_by_id FK
        datetime created_at
    }
    RECEIPT {
        uuid id PK
        uuid company_id FK
        uuid box_id FK,UK
        uuid branch_id FK
        uuid actor_id FK
        string internal_id "Snapshot"
        string result "RECEIVED o REJECTED"
        string reason "Vacio o enum de rechazo"
        string source
        uuid idempotency_key "UNIQUE empresa actor clave"
        datetime created_at
    }
    BOX_EVENT {
        uuid id PK
        uuid company_id FK
        uuid box "Snapshot sin FK, sobrevive borrado"
        uuid branch_id FK
        uuid actor_id FK
        string internal_id "Snapshot"
        string event_type
        string outcome
        json data "Allowlist acotada"
        datetime created_at
    }
